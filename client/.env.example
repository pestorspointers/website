# The whole app — site, admin and API — runs from this one Next project, so
# these are all the variables it needs.

# ─── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API. Both of these are safe to expose to the browser —
# the publishable key (formerly "anon") is governed by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Bypasses Row Level Security — never expose this to the browser.
SUPABASE_SECRET_KEY=

# Only needed if your project still signs JWTs with the legacy HS256 secret
# (Project Settings → API → JWT Settings). Projects using the newer asymmetric
# signing keys can leave this blank — the API reads the public JWKS instead.
SUPABASE_JWT_SECRET=

# ─── Site ────────────────────────────────────────────────────────────────────
# Canonical public URL. Used for SEO metadata, and for building Stripe redirect
# URLs and Supabase invite links, so it has to be the real origin in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen --forward-to localhost:3000/api/v1/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── AWS video pipeline ──────────────────────────────────────────────────────
# The APP_ prefix is not decoration: Amplify rejects variables starting with
# AWS, and the Lambda runtime sets AWS_REGION and the AWS key pair itself.
APP_AWS_ACCESS_KEY_ID=
APP_AWS_SECRET_ACCESS_KEY=
# The Pestor's Pointers buckets live in Ohio. Every other AWS value below has to
# be from the same region or calls fail with a confusing "bucket not found".
APP_AWS_REGION=us-east-2
# One bucket holds both `uploads/raw/…` and `videos/hls/…`.
S3_BUCKET_NAME=pestors-course-material-vids
CLOUDFRONT_DOMAIN=https://xxxxxxxx.cloudfront.net
CLOUDFRONT_KEY_PAIR_ID=
# The CloudFront signing private key, base64 encoded:
#   base64 -i private_key.pem | tr -d '\n'
CLOUDFRONT_PRIVATE_KEY=
# Region-specific — find yours under MediaConvert → Account in the us-east-2 console.
MEDIACONVERT_ENDPOINT=https://xxxxxxxx.mediaconvert.us-east-2.amazonaws.com
MEDIACONVERT_ROLE_ARN=arn:aws:iam::666278775782:role/MediaConvertRole
