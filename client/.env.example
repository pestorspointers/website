# ─── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API. Both of these are safe to expose to the browser —
# the anon key is governed by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── API ─────────────────────────────────────────────────────────────────────
# Used by server components (never sent to the browser). Point it at the
# internal address of the Express API in production if you have one.
API_URL=http://localhost:5001
# Used by browser code.
NEXT_PUBLIC_API_URL=http://localhost:5001

# ─── Site ────────────────────────────────────────────────────────────────────
# Canonical public URL, used for SEO metadata and sitemap links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
