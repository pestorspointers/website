# These scripts are one-off AWS tooling, not a running service. The application
# and its API live in client/ — see client/.env.example for the app's settings.
#
# Run them from this directory so dotenv picks up server/.env.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
S3_BUCKET_NAME=pestors-course-material-vids
CLOUDFRONT_DOMAIN=https://xxxxxxxx.cloudfront.net
CLOUDFRONT_KEY_PAIR_ID=
MEDIACONVERT_ENDPOINT=https://xxxxxxxx.mediaconvert.us-east-2.amazonaws.com
MEDIACONVERT_ROLE_ARN=arn:aws:iam::666278775782:role/MediaConvertRole

# Used by the import/link scripts to write rows directly.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
