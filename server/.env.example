# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5001
# Comma-separated list of origins allowed to call this API.
CLIENT_URL=http://localhost:3000

# ─── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# SERVICE ROLE key — bypasses Row Level Security. Server only. Never ship this
# to the browser and never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Only needed if your project still signs JWTs with the legacy HS256 secret
# (Project Settings → API → JWT Settings). Projects using the newer asymmetric
# signing keys can leave this blank — the API reads the public JWKS instead.
SUPABASE_JWT_SECRET=

# ─── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen --forward-to localhost:5001/api/v1/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── AWS video pipeline ──────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# The Pestor's Pointers buckets live in Ohio. Every other AWS value below has to
# be from the same region or calls fail with a confusing "bucket not found".
AWS_REGION=us-east-2
# One bucket holds both `uploads/raw/…` and `videos/hls/…`. Existing candidates
# in account 666278775782: pestors-course-material-vids, pestors-course-material.
S3_BUCKET_NAME=pestors-course-material-vids
CLOUDFRONT_DOMAIN=https://xxxxxxxx.cloudfront.net
CLOUDFRONT_KEY_PAIR_ID=
# The CloudFront signing private key, base64 encoded:
#   base64 -i private_key.pem | tr -d '\n'
CLOUDFRONT_PRIVATE_KEY=
# Region-specific — find yours under MediaConvert → Account in the us-east-2 console.
MEDIACONVERT_ENDPOINT=https://xxxxxxxx.mediaconvert.us-east-2.amazonaws.com
MEDIACONVERT_ROLE_ARN=arn:aws:iam::666278775782:role/MediaConvertRole
